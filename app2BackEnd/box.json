{
    "chmod": "0755",
    "main": "artisan",
    "output": "app.phar",
    "directories": [
        "app", 
        "bootstrap", 
        "config", 
        "database", 
        "public", 
        "resources", 
        "routes", 
        "vendor", 
        "storage"
    ],
    "files": [
        ".env.example"
    ],
    "dump-autoload": true,
    "intercept": true,
    "blacklist": [
        "node_modules",
        "tests",
        "storage/logs/*.log",
        ".git"
    ]
}