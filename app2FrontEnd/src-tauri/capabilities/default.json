{
  "$schema": "../gen/schemas/desktop-capability.schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "dialog:default",
    "shell:allow-open",
    "allow-get-api-config",
    "allow-open-url",
    "allow-import-database",
    "allow-export-database"
  ]
}